{
  "name": "@zaggino/postgres-mcp",
  "version": "0.4.0",
  "description": "PostgreSQL MCP server with index tuning, explain plans, health checks and safe SQL execution",
  "keywords": [
    "database-health",
    "explain",
    "index-tuning",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "postgres",
    "postgresql",
    "sql"
  ],
  "homepage": "https://github.com/zaggino/postgres-mcp#readme",
  "bugs": {
    "url": "https://github.com/zaggino/postgres-mcp/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaggino/postgres-mcp.git"
  },
  "bin": {
    "postgres-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepack": "pnpm build",
    "prepare": "lefthook install || exit 0",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "diff": "9.0.0",
    "jsonc-parser": "3.3.1",
    "libpg-query": "18.2.5",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.10",
    "@types/pg": "8.23.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "testcontainers": "12.2.2",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "ultracite": "8.3.1",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.23.0"
}
