{
  "name": "@zaggino/postgres-mcp",
  "version": "0.4.0",
  "description": "PostgreSQL MCP server with index tuning, explain plans, health checks and safe SQL execution",
  "homepage": "https://github.com/zaggino/postgres-mcp#readme",
  "bugs": {
    "url": "https://github.com/zaggino/postgres-mcp/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaggino/postgres-mcp.git"
  },
  "bin": {
    "postgres-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepack": "pnpm build",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32",
    "diff": "^9",
    "libpg-query": "^18.2",
    "pg": "^8.23",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/pg": "^8",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "testcontainers": "^12",
    "tsdown": "^0.23",
    "typescript": "~7.0",
    "ultracite": "^8",
    "vitest": "^5"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.18.0"
}
